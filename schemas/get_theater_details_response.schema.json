{
  "type": "object",
  "properties": {
    "success": {
      "description": "Indica se a busca foi bem-sucedida",
      "type": "boolean",
      "const": true
    },
    "data": {
      "$ref": "#/definitions/theater_details"
    }
  },
  "required": ["success", "data"],
  "additionalProperties": false,

  "definitions": {
    "theater_details": {
      "description": "Objeto representando uma sala (theater) detalhada",
      "type": "object",
      "properties": {
        "_id": { "type": "string" },
        "name": { "type": "string" },
        "capacity": { "type": "integer" },
        "type": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "__v": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "id": { "type": "string" },
        "sessions": {
          "description": "Lista de sessões populadas para esta sala",
          "type": "array",
          "items": { "$ref": "#/definitions/session" }
        }
      },
      "required": ["_id", "name", "capacity", "type", "createdAt", "id", "sessions"],
      "additionalProperties": false
    },

    "session": {
      "description": "Objeto representando uma sessão embutida",
      "type": "object",
      "properties": {
        "_id": { "type": "string" },
        "movie": { "type": "string", "pattern": "^[0-9a-fA-F]{24}$" },
        "theater": { "type": "string", "pattern": "^[0-9a-fA-F]{24}$" },
        "datetime": { "type": "string", "format": "date-time" },
        "fullPrice": { "type": "number" },
        "halfPrice": { "type": "number" },
        "seats": {
          "type": "array",
          "items": { "$ref": "#/definitions/seat" }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "__v": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "id": { "type": "string" }
      },
      "required": ["_id", "movie", "theater", "datetime", "fullPrice", "halfPrice", "seats", "createdAt", "id"],
      "additionalProperties": false
    },

    "seat": {
      "description": "Objeto representando um assento embutido",
      "type": "object",
      "properties": {
        "row": { "type": "string" },
        "number": { "type": "integer" },
        "status": { "type": "string", "enum": ["available", "reserved", "locked"] }
      },
      "required": ["row", "number", "status"],
      "additionalProperties": false
    }
  }
}